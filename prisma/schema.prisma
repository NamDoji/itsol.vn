generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  sales
  hr
}

enum RequestStatus {
  new
  contacted
  qualified
  closed
}

enum StaffingStatus {
  New
  Analyzing
  MatchingTalents
  ShortlistSent
  Interviewing
  Contracting
  Onboarded
  Closed
}

// CV / Application pipeline stages
enum CandidateStage {
  Received       // CV vừa nhận
  Screening      // HR đang xem hồ sơ
  PhoneInterview // Đặt lịch phone/video
  TechInterview  // Phỏng vấn kỹ thuật
  ReferenceCheck // Kiểm tra tham chiếu
  OfferSent      // Đã gửi offer
  Hired          // Đã ký hợp đồng
  Rejected       // Từ chối
  OnHold         // Tạm dừng
}

enum TalentStatus {
  Available
  Interviewing
  Assigned
  Unavailable
  Onboarded
  Onsite
  Inactive
}

enum TimesheetStatus {
  Draft
  HRSubmitted     // HR nộp lên CHRM review
  CHRMApproved    // CHRM đã duyệt
  BODApproved     // BOD đã duyệt
  ClientApproved  // Khách hàng xác nhận giờ công
  Invoiced        // Đã xuất hóa đơn
  Disputed        // Khách hàng tranh chấp
  // Keep for backward compat:
  Submitted
  Approved
  Billed
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(admin)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactRequest {
  id         Int           @id @default(autoincrement())
  name       String
  company    String?
  email      String
  phone      String?
  service    String?
  message    String
  attachment String?
  status     RequestStatus @default(new)
  assignedTo String?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model StaffingRequest {
  id              Int              @id @default(autoincrement())
  companyName     String
  contactPerson   String
  email           String
  phone           String
  country         String?
  serviceModel    String
  numberOfTalents Int
  role            String
  seniority       String
  technologyStack String
  englishLevel    String?
  japaneseLevel   String?
  startDate       String?
  duration        String?
  budgetRange     String?
  jobDescription  String?
  notes           String?
  owner           String?
  internalNotes   String?
  status          StaffingStatus   @default(New)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  talentRequests  TalentRequest[]
  activities      StaffingActivity[]
}

// Activity / note log for each staffing request
model StaffingActivity {
  id                Int             @id @default(autoincrement())
  staffingRequestId Int
  actor             String          // tên người thực hiện
  action            String          // "status_change" | "note" | "shortlist_sent" | "interview_scheduled"
  fromStatus        String?
  toStatus          String?
  note              String?
  createdAt         DateTime        @default(now())
  staffingRequest   StaffingRequest @relation(fields: [staffingRequestId], references: [id], onDelete: Cascade)
}

model Talent {
  id              Int             @id @default(autoincrement())
  code            String          @unique
  // ── Thông tin cá nhân ─────────────────────────────────
  fullName        String?         // Họ và tên
  email           String?         // Email
  phone           String?         // SĐT
  dateOfBirth     DateTime?       // Ngày sinh
  gender          String?         // male | female | other
  idNumber        String?         // CMND / CCCD
  address         String?         // Địa chỉ
  // ── Thông tin nghề nghiệp ────────────────────────
  role            String
  department      String?         // Phòng ban
  seniority       String
  skills          String
  yearsExperience Int
  englishLevel    String
  japaneseLevel   String
  availability    String
  location        String
  workingModel    String
  status          TalentStatus    @default(Available)
  summary         String
  // ── Hợp đồng ──────────────────────────────────────
  contractType    String?         // fulltime | parttime | probation | freelance | intern
  contractStart   DateTime?       // Ngày bắt đầu HGĐ hiện tại
  contractEnd     DateTime?       // Ngày kết thúc HGĐ
  contractNumber  String?         // Số HGĐ
  // ── Lương & Phúc lợi ─────────────────────────────
  grossSalary     Float?          // Lương gross (VND/tháng)
  netSalary       Float?          // Lương net (VND/tháng)
  socialInsurance Float?          // BHXH đóng phần công ty/tháng (VND)
  healthInsurance Float?          // BHYT đóng phần công ty/tháng (VND)
  otherAllowance  Float?          // Phụ cấp khác/tháng
  totalCost       Float?          // Tổng chi phí/tháng (auto = gross+BH+phụ cấp)
  // ── Bill khách hàng ────────────────────────────────
  billingRate     Float?          // Mức bill chuẩn (VND hoặc USD)
  billingRate2    Float?          // Mức bill 2 (onsite / quốc tế)
  billingCurrency String          @default("VND")
  expectedRate    String?         // Khoảng rate mong muốn (legacy)
  // ── Meta ─────────────────────────────────────────
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  talentRequests  TalentRequest[]
  timesheets      Timesheet[]
  assignments     ProjectAssignment[]
  contracts       StaffContract[]
}

model StaffContract {
  id              Int       @id @default(autoincrement())
  staffId         Int
  contractNumber  String?   // Số HGĐ
  contractType    String    @default("fulltime") // fulltime | parttime | probation | freelance | intern
  startDate       DateTime
  endDate         DateTime?
  grossSalary     Float?    // Lương gross trong HGĐ này
  netSalary       Float?    // Lương net trong HGĐ này
  socialInsurance Float?    // BHXH/tháng
  healthInsurance Float?    // BHYT/tháng
  billingRate     Float?    // Bill rate tại thời điểm
  notes           String?   // Ghi chú
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  staff           Talent    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model TalentRequest {
  id                Int              @id @default(autoincrement())
  talentId          Int
  staffingRequestId Int?
  companyName       String
  contactPerson     String
  email             String
  phone             String?
  message           String?
  status            RequestStatus    @default(new)
  createdAt         DateTime         @default(now())
  talent            Talent           @relation(fields: [talentId], references: [id], onDelete: Cascade)
  staffingRequest   StaffingRequest? @relation(fields: [staffingRequestId], references: [id], onDelete: SetNull)
}

model Timesheet {
  id            Int             @id @default(autoincrement())
  talentId      Int
  clientName    String
  month         String
  workingDays   Int
  approvedDays  Int
  overtimeHours Int             @default(0)
  status        TimesheetStatus @default(Draft)
  clientRating  Int?
  note          String?
  projectId     Int?
  approvedBy    String?         // tên người duyệt
  invoiceRef    String?         // số hóa đơn
  // Snapshot lương/billing tại thời điểm (override từ ProjectAssignment)
  grossSalary   Float?          // Lương gross tháng này
  billingRate   Float?          // Bill KH tháng này
  billingCurrency String?       // VND | USD
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  talent        Talent          @relation(fields: [talentId], references: [id], onDelete: Cascade)
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Project {
  id              Int       @id @default(autoincrement())
  name            String
  clientName      String
  clientEmail     String?
  clientPhone     String?                    // SĐT liên hệ khách hàng
  contractNumber  String?                    // Số hợp đồng
  projectType     String    @default("Staffing") // FixedPrice | ODC | Staffing
  contractValue   Float?                     // Giá trị HĐ (chỉ dùng cho FixedPrice)
  status          String    @default("active") // active | completed | paused | cancelled
  startDate       DateTime?
  endDate         DateTime?
  rate            String?                    // legacy
  currency        String    @default("VND")
  description     String?
  isBackOffice    Boolean   @default(false)  // Dự án Back Office nội bộ
  overheadRate    Float     @default(0.30)   // % chi phí back office phân bổ
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  assignments     ProjectAssignment[]
  timesheets      Timesheet[]
}

model ProjectAssignment {
  id              Int       @id @default(autoincrement())
  talentId        Int
  projectId       Int
  role            String?
  startDate       DateTime?
  endDate         DateTime?
  status          String    @default("active") // active | ended
  // Salary & billing for this specific assignment
  grossSalary     Float?    // Lương gross (override, VND/tháng)
  netSalary       Float?    // Lương net (override, VND/tháng)
  billingRate     Float?    // Bill khách hàng (VND or USD/tháng)
  billingCurrency String    @default("VND") // VND | USD
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  talent          Talent    @relation(fields: [talentId], references: [id], onDelete: Cascade)
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Job {
  id           Int              @id @default(autoincrement())
  title        String
  department   String
  location     String
  level        String           // Junior / Mid / Senior (legacy, giữ để hiển public)
  headcount    Int              @default(1)   // Số lượng cần tuyển
  description  String           // Mô tả công việc
  requirements String?          // Yêu cầu ứng viên
  benefits     String?          // Chế độ đãi ngộ
  expiresAt    DateTime?        // Ngày hết hạn tin tuyển
  published    Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
}

model JobApplication {
  id              Int            @id @default(autoincrement())
  jobId           Int?
  name            String
  email           String
  phone           String?
  position        String
  cvUrl           String?        @db.Text
  message         String?
  status          RequestStatus  @default(new)
  internalNotes   String?
  projectMatch    String?
  candidateStatus CandidateStage @default(Received)
  assignedTo      String?
  interviewDate   DateTime?
  offerDate       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  job             Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  activities      ApplicationActivity[]
}

// Activity log for each CV/application
model ApplicationActivity {
  id            Int            @id @default(autoincrement())
  applicationId Int
  actor         String
  action        String         // "stage_change" | "note" | "interview_scheduled" | "offer_sent"
  fromStage     String?
  toStage       String?
  note          String?
  scheduledAt   DateTime?
  createdAt     DateTime       @default(now())
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  titleVi     String
  titleEn     String
  excerptVi   String
  excerptEn   String
  contentVi   String
  contentEn   String
  category    String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductInquiry {
  id        Int           @id @default(autoincrement())
  product   String
  name      String
  company   String?
  email     String
  phone     String?
  message   String?
  status    RequestStatus @default(new)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// CMS: dynamic content blocks (about page, service details, etc.)
model ContentBlock {
  id        Int      @id @default(autoincrement())
  page      String   // "about" | "home" | "staffing" | "services"
  section   String   // "hero" | "mission" | "team_intro" | etc.
  titleVi   String?
  titleEn   String?
  bodyVi    String?  @db.Text
  bodyEn    String?  @db.Text
  meta      String?  // JSON for extra fields (image, cta, etc.)
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  locale    String   @default("en")
  createdAt DateTime @default(now())
}
